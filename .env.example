# Copy to .env.local for local development. Placeholder values only — never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MANDRILL_API_KEY=placeholder
EMAIL_FROM="OnePeek Secret <secret@example.com>"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=placeholder
VAPID_PRIVATE_KEY=placeholder
VAPID_SUBJECT=mailto:secret@example.com
# Secret Chat: Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to cron routes.
CRON_SECRET=generate-a-long-random-string
# Mobile app: native push. Server-side only (Vercel), never in the app. Without them the senders are no-ops.
APNS_KEY_ID=placeholder
APNS_TEAM_ID=placeholder
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nplaceholder\n-----END PRIVATE KEY-----"
APNS_BUNDLE_ID=io.onepeek.app
APNS_USE_SANDBOX=0
FCM_SERVICE_ACCOUNT_JSON={"project_id":"placeholder","client_email":"placeholder","private_key":"placeholder"}
# Mobile app: Universal Links / App Links. Both /.well-known files return 404 until these are set.
APPLE_TEAM_ID=placeholder
ANDROID_SHA256_CERT_FINGERPRINTS=placeholder
